-- 3. Security
ALTER TABLE public.services ENABLE ROW LEVEL SECURITY;

-- Allow public read access
DROP POLICY IF EXISTS "Allow public read access" ON public.services;
CREATE POLICY "Allow public read access"
  ON public.services
  FOR SELECT
  USING (true);

-- Restrict modifications to admin/service roles
DROP POLICY IF EXISTS "Allow admin modification" ON public.services;
CREATE POLICY "Allow admin modification"
  ON public.services
  FOR ALL -- Covers INSERT, UPDATE, DELETE
  USING (auth.role() = 'service_role' OR auth.role() = 'postgres')
  WITH CHECK (auth.role() = 'service_role' OR auth.role() = 'postgres');

-- Ensure default roles like 'authenticated' or 'anon' cannot modify
DROP POLICY IF EXISTS "Deny modification for other roles" ON public.services;
CREATE POLICY "Deny modification for other roles"
  ON public.services
  FOR ALL
  USING (false); -- Effectively denies unless overridden by a specific permissive policy
